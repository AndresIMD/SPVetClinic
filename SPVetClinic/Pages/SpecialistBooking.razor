@page "/reservas"

@inject NavigationManager Navigation

<PageTitle>Reserva con especialista | @AppConstants.Clinic.Name</PageTitle>

<HeadContent>
    <meta name="description"
          content="Agenda tu consulta con los especialistas veterinarios de San Pablo Vet clínic a través de recepción por WhatsApp." />
</HeadContent>

<main class="container" style="padding: 6rem 1rem; text-align: center;">
    <h1>Redirigiendo a recepción</h1>
    <p>La agenda de especialistas se gestiona por recepción vía WhatsApp.</p>
    <a href="@AppConstants.Urls.WhatsAppMainLink"
       target="_blank"
       rel="noopener noreferrer"
       class="btn-primary">
        Escribir a recepción
    </a>
</main>

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo(AppConstants.Urls.WhatsAppMainLink, forceLoad: true);
    }
}
