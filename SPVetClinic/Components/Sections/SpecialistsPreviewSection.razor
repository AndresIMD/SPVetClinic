<section class="vc-section">
    <div class="vc-w">
        <SectionHeader Tag="Equipo Médico" Title="Especialistas certificados" CssClass="vc-section-header--home" />

        <div class="vc-specs">
            @foreach (var s in Specialties.All)
            {
                <a href="especialistas" class="vc-spec-card reveal">
                    <div class="vc-spec-card__icon"><Icon Name="@s.Icon" Size="28" /></div>
                    <h3>@s.Name</h3>
                    <span class="vc-spec-card__role">@string.Join(" · ", s.Doctors)</span>
                </a>
            }
        </div>
    </div>
</section>
